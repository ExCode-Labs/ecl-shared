{
  "name": "ecl-shared",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspace=@excodelabs/ui",
    "lint:fix": "npm run lint:fix --workspace=@excodelabs/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=@excodelabs/ui",
    "build": "npm run build --workspace=@excodelabs/ui",
    "publish:ui": "npm publish --workspace=@excodelabs/ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8"
  }
}
